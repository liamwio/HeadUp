    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "server/**/*.ts",
    "src/family/aiContract.ts",
    "src/family/cloudContract.ts",
