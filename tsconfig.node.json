    "src/family/shareContract.ts",
    "src/lib/imageInputPreflight.ts",
    "src/lib/reportRecordValidation.ts",
    "src/lib/measurementEvidence.ts",
    "src/lib/errorEvidence.ts",
    "src/family/aiReadings.ts",
    "src/family/comparisonReasons.ts",
    "src/lib/readingCopy.ts",
    "src/lib/metricUncertainty.ts",
    "src/family/participation.ts",
    "src/family/dates.ts",
    "src/family/planCompletion.ts",
    "src/lib/photoQualityAcceptance.ts",
    "src/lib/captureSelection.ts",
