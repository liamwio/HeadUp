HEADUP_FAMILY_ENABLED=1
HEADUP_DATA_DIR=.headup-server
# Local development only. Public deployment must use HTTPS and secure cookies.
HEADUP_COOKIE_SECURE=0
HEADUP_APP_ORIGINS=http://127.0.0.1:5191,http://localhost:5191,http://127.0.0.1:5190,http://localhost:5190,http://127.0.0.1:5173,http://localhost:5173
# For public HTTPS deployment, set a private registration code (or use bound invitations).
HEADUP_REGISTRATION_CODE=
