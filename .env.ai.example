# Server-only configuration. Do not use a VITE_ prefix for secrets.
HEADUP_AI_ENDPOINT=https://your-provider.example/v1/chat/completions
HEADUP_AI_MODEL=your-model-name
HEADUP_AI_API_KEY=
HEADUP_AI_PROVIDER_LABEL=Your provider
# off for providers that do not support response_format.
HEADUP_AI_JSON_MODE=on
# Set max_completion_tokens if required by the chosen model.
HEADUP_AI_TOKEN_FIELD=max_tokens
HEADUP_API_PORT=5191
HEADUP_APP_ORIGINS=http://127.0.0.1:5191,http://localhost:5191,http://127.0.0.1:5190,http://localhost:5190,http://127.0.0.1:5173,http://localhost:5173
